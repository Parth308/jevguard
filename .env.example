# ==============================================================================
# JevGuard Configuration
# ==============================================================================

# 1. TypeSafe / Vercel AI Gateway API key (for JevGuard)
# Direct TypeSafe key: sk-... (https://console.typesafe.ai/keys)
# OR Vercel AI Gateway key: vck_... (https://vercel.com/docs/ai/gateway)
TYPESAFE_API_KEY=vck_...

# ==============================================================================
# Optional: LLM-as-a-Judge Live Benchmark Configuration
# ==============================================================================

# Option A: Groq (100% Free - get key at https://console.groq.com)
GROQ_API_KEY=gsk_...
# Model defaults to qwen/qwen3.8-27b (or llama-3.3-70b-versatile)
LLM_JUDGE_MODEL=qwen/qwen3.8-27b

# Option B: OpenRouter / OpenAI / Ollama
# LLM_JUDGE_MODEL=qwen/qwen-2.5-72b-instruct
# LLM_JUDGE_API_KEY=sk-or-v1-...
# LLM_JUDGE_BASE_URL=https://openrouter.ai/api/v1

# ==============================================================================
# Optional: Local Laya System 1 Server (NVIDIA RTX 3050 GPU Accelerated)
# ==============================================================================
# Start server with: npm run laya:serve
LAYA_BASE_URL=http://127.0.0.1:8000
