# ==============================================================================
# JevGuard Configuration
# ==============================================================================

# 1. TypeSafe / Vercel AI Gateway API key (for JevGuard)
# Direct TypeSafe key: sk-... (https://console.typesafe.ai/keys)
# OR Vercel AI Gateway key: vck_... (https://vercel.com/docs/ai/gateway)
TYPESAFE_API_KEY=vck_...

# ==============================================================================
# Optional: LLM-as-a-Judge Live Benchmark Configuration
# ==============================================================================

# Model to evaluate against (e.g. Qwen, Llama, GPT-4o-mini)
# Default: qwen-2.5-32b-instruct (or qwen/qwen-2.5-72b-instruct via OpenRouter)
LLM_JUDGE_MODEL=qwen/qwen-2.5-72b-instruct

# API Key for the LLM Judge endpoint
# Can be OpenRouter (sk-or-v1-...), Groq (gsk_...), OpenAI (sk-proj-...), etc.
LLM_JUDGE_API_KEY=

# Base URL for the OpenAI-compatible endpoint
# Defaults automatically:
# - If key starts with "sk-or-v1-": https://openrouter.ai/api/v1
# - If key starts with "gsk_":      https://api.groq.com/openai/v1
# - Otherwise:                      https://api.openai.com/v1
# Custom / local models (e.g. Ollama): http://localhost:11434/v1
LLM_JUDGE_BASE_URL=https://openrouter.ai/api/v1
