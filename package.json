{
  "name": "jevguard",
  "version": "0.1.0",
  "description": "Type-safe LLM guardrail middleware powered by Jev (TypeSafe System One).",
  "license": "MIT",
  "author": "Parth",
  "repository": {
    "type": "git",
    "url": "https://github.com/Parth308/jevguard.git"
  },
  "keywords": [
    "guardrails",
    "llm-security",
    "prompt-injection",
    "ai",
    "vercel-ai-sdk",
    "typesafe"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "types": "./dist/ai/index.d.ts"
    }
  },
  "bin": {
    "jevguard": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "guard": "tsx src/bin.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "benchmark": "tsx benchmarks/run-benchmark.ts",
    "benchmark:laya": "tsx benchmarks/run-laya-only.ts",
    "laya:serve": "python scripts/laya_server.py --install"
  },
  "dependencies": {
    "ai": "^7.0.107"
  },
  "optionalDependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "ai": ">=3.4.0 || >=4.0.0 || >=7.0.0",
    "zod": ">=3.20.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.8"
  }
}
